{
  "name": "skd-workbench",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "graft": "node scripts/graft.mjs",
    "graft:setup": "node scripts/graft.mjs setup",
    "graft:build": "node scripts/graft.mjs build",
    "graft:check": "node scripts/graft.mjs check",
    "graft:map": "node scripts/graft.mjs map",
    "postinstall": "node scripts/prepare-terminal.mjs",
    "mcp": "node scripts/workbench-mcp.mjs",
    "launcher:install": "node scripts/install-launcher.mjs",
    "remote-access": "node scripts/remote-access.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@nanonets/graft": "0.18.0",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cytoscape": "3.34.3",
    "dompurify": "3.4.15",
    "gray-matter": "4.0.3",
    "marked": "18.0.13",
    "node-pty": "^1.1.0",
    "smol-toml": "1.8.0",
    "ws": "^8.21.3",
    "zod": "3.25.76"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
